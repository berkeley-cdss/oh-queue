[flake8]
max-line-length = 127
# prev_versions are migrations Alembic no longer loads
exclude = .git,__pycache__,venv,node_modules,build,dist,docs,migrations/prev_versions
extend-ignore = E722, F401
# Higher than seating's 10: emit_state, resolve and create_login_client are 12-13,
# and splitting them only for this isn't worth it. New code should stay well under.
max-complexity = 15
per-file-ignores =
    # autogenerated migrations import the models with *
    migrations/versions/*: E402, F403, F405
