# Copy to .env for local development. Never commit .env.

# dev or prod. Required: the app won't start without it.
ENV=dev
FLASK_APP=manage.py

# Required outside development.
SECRET_KEY=
# Required outside development, unless CLOUD_SQL_INSTANCE is set; in
# development the app uses app.db (SQLite).
DATABASE_URL=
# Deployments connect to Cloud SQL as the service account they run as (IAM
# database auth, so no password) instead of using DATABASE_URL.
# CLOUD_SQL_INSTANCE=project:region:instance
# DB_USER=service-account@project.iam
# DB_NAME=oh

# In development, Canvas is mocked unless this is false: sign in at /dev_login/
# as one of the fake Canvas's users, with no Canvas key needed.
MOCK_CANVAS=true
# Canvas developer key. Required with MOCK_CANVAS=false and in production;
# locally, use the UC Berkeley sandbox key: https://ucberkeleysandbox.instructure.com/
CANVAS_SERVER_URL=https://ucberkeleysandbox.instructure.com/
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
# Optional: members of this Canvas course are staff in every course.
ADMIN_OVERRIDE_CANVAS_COURSE_ID=
