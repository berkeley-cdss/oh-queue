# Copy to .env for local development. Never commit .env.

# dev or prod. Required: the app won't start without it.
ENV=dev
FLASK_APP=manage.py
EVENTLET_NO_GREENDNS=yes

# Required outside development.
SECRET_KEY=
# Required outside development; in development the app uses app.db (SQLite).
DATABASE_URL=

# The course this deployment serves: the key stored with each row, and its
# bCourses course. Required outside development; in development, cs61a and the
# UC Berkeley sandbox's test course.
COURSE_KEY=
CANVAS_COURSE_ID=

# Canvas developer key. Locally, use the UC Berkeley sandbox key:
# https://ucberkeleysandbox.instructure.com/
CANVAS_SERVER_URL=https://ucberkeleysandbox.instructure.com/
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=
# Optional: members of this Canvas course are staff in every course.
ADMIN_OVERRIDE_CANVAS_COURSE_ID=

# Optional: LLM tips.
LLM_TIPS_ENDPOINT=
LLM_TIPS_AUTH_TOKEN=
